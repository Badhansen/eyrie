{
  "name": "eyrie-monorepo",
  "private": true,
  "description": "Local-first live architecture graph for codebases",
  "license": "AGPL-3.0-only",
  "author": "Badhan Sen",
  "homepage": "https://github.com/Badhansen/eyrie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Badhansen/eyrie.git"
  },
  "bugs": {
    "url": "https://github.com/Badhansen/eyrie/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @eyrie/server --filter @eyrie/web dev",
    "build": "pnpm --filter @eyrie/web build",
    "start": "pnpm build && tsx packages/server/src/cli.ts",
    "eyrie": "tsx packages/server/src/cli.ts",
    "arch": "tsx scripts/arch-review/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:fetch": "bash scripts/fetch-smoke-repo.sh",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @eyrie/web typecheck && pnpm --filter @eyrie/desktop typecheck",
    "desktop": "pnpm --filter @eyrie/desktop start"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
