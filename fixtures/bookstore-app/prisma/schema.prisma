datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id     String  @id @default(cuid())
  email  String  @unique
  orders Order[]
}

model Book {
  id       String      @id @default(cuid())
  title    String
  author   String
  price    Int
  items    OrderItem[]
}

model Order {
  id         String      @id @default(cuid())
  customerId String
  summary    String
  status     String
  customer   Customer    @relation(fields: [customerId], references: [id])
  items      OrderItem[]
  payment    Payment?
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  bookId   String
  quantity Int
  order    Order  @relation(fields: [orderId], references: [id])
  book     Book   @relation(fields: [bookId], references: [id])
}

model Payment {
  id      String @id @default(cuid())
  orderId String @unique
  status  String
  order   Order  @relation(fields: [orderId], references: [id])
}
