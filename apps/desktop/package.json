{
  "name": "@eyrie/desktop",
  "productName": "Eyrie",
  "version": "0.1.0",
  "private": true,
  "description": "Eyrie desktop app: an Electron shell that runs the engine locally and shows its UI",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Badhan Sen",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "resources": "pnpm --filter @eyrie/web build && tsx scripts/prepare-resources.ts",
    "start": "pnpm resources && electron-forge start",
    "package": "pnpm resources && electron-forge package",
    "make": "pnpm resources && electron-forge make",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons": "electron scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@eyrie/core": "workspace:*",
    "@eyrie/engine": "workspace:*",
    "@eyrie/knowledge": "workspace:*",
    "@eyrie/parser": "workspace:*",
    "@eyrie/server": "workspace:*",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.18.0",
    "electron": "44.7.2",
    "electron-squirrel-startup": "1.0.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "8.3.3",
    "vitest": "^5.0.3"
  }
}
